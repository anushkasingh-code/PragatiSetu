# PragatiSetu Backend Environment Configuration Template

# Database Connection URL
# For PostgreSQL (Docker / Production / Local Postgres Service):
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/site2schedule
# For Local Standalone SQLite Option:
# DATABASE_URL=sqlite:///./site2schedule.db

# Application Environment & Log Level
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Security & CORS Origins (Comma-separated list or * for local dev)
CORS_ORIGINS=*

# Storage Configuration Directories
UPLOAD_DIR=uploads
AUDIO_UPLOAD_DIR=uploads/audio

# File Size Limits (Bytes)
MAX_FILE_SIZE_BYTES=10485760
MAX_AUDIO_SIZE_BYTES=10485760

# Voice & Local Speech-To-Text (STT) Settings
VOICE_ENABLED=true
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Safety Decision Policy Thresholds
MATCH_SCORE_THRESHOLD=85.0
EVIDENCE_COMPLETENESS_THRESHOLD=70.0
TOP2_MARGIN_THRESHOLD=12.0

# Optional Vector DB (ChromaDB) Configuration
VECTOR_DB_DIR=vector_store
VECTOR_COLLECTION_NAME=pragatisetu_activities

# Optional Groq LLM Reasoning Configuration (Informational Reviewer Assistance Only)
GROQ_ENABLED=false
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

